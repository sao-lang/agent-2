# exec 形态：PID 1 是 python，信号直达。
# 这里用官方 slim 镜像；生产上把 tag 换成 digest（@sha256:...）以固定构建结果。
FROM python:3.12-slim

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app /app

ENV PYTHONUNBUFFERED=1
RUN useradd -m app && chown -R app /app
USER app
EXPOSE 8000

# JSON 数组形式：没有 shell 包一层
CMD ["python", "-u", "app.py"]
