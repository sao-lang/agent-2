# 复制成 .env 后再改：Windows 用 copy，Linux/macOS 用 cp
# 【绝对不要】把这个文件以外的密钥写进 Dockerfile 或镜像

# 数据库密码：上线必须换成强随机
POSTGRES_PASSWORD=change-me-please

# Langfuse 需要两个随机串，生成方法：
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
NEXTAUTH_SECRET=replace-with-random-32-chars
LANGFUSE_SALT=replace-with-another-random

# fake = 不调真实模型（默认，无需密钥）
# openai = 调真实模型，需要下面这个 key
LLM_MODE=fake
OPENAI_API_KEY=

# 前端宿主机端口（8080 常被占用，冲突就改成 8081）
FRONTEND_PORT=8080
