# .dockerignore —— 这一份文件经常是"镜像 2GB → 300MB"的最大单点

# 版本库与 IDE
.git
.gitignore
.vscode
.idea

# Python 缓存与虚拟环境（虚拟环境动辄几百 MB，绝不能进镜像）
**/__pycache__
**/*.pyc
.venv
venv
.pytest_cache
.ruff_cache
.mypy_cache

# 本地密钥与配置（!!! 最重要的三条 !!!）
.env
.env.*
!.env.example
*.pem
*.key

# 模型与数据（这些应该挂 volume 或启动时下载）
models/
*.bin
*.safetensors
*.gguf
data/
*.sqlite
*.db

# 构建产物与日志
node_modules
dist
build
*.log
.traces

# 文档（运行镜像里不需要 markdown 源码和书稿）
*.md
docs/
examples/
